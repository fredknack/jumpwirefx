# Public base URL of the site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://jumpwirefx.com

# Vercel Blob read/write token (only needed by `pnpm media` to upload videos)
BLOB_READ_WRITE_TOKEN=

# Phase 2 (CMS)
# Neon Postgres connection string (from the Vercel Marketplace integration). Unset = read seed files.
DATABASE_URL=
# 32+ random characters: openssl rand -base64 32
AUTH_SECRET=
# bcrypt hash of the admin password: pnpm admin:hash
# In .env files escape every $ as \$ (pnpm admin:hash prints the line ready to paste); quotes do not protect it.
ADMIN_PASSWORD_HASH=
